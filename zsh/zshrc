# ---------------------------------------------------------------------------
# Oh My Zsh
# ---------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

# Prompt is handled by Starship (see below) — leave this empty.
ZSH_THEME=""

# Do NOT add zsh-autosuggestions or zsh-syntax-highlighting here —
# they're sourced from Homebrew at the bottom of this file.
plugins=(git)

source $ZSH/oh-my-zsh.sh

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"
export EDITOR="nvim"

# ---------------------------------------------------------------------------
# History
# ---------------------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS HIST_VERIFY

autoload -U up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'   # case-insensitive

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------
# eza — modern ls
alias ls="eza --icons --group-directories-first"
alias ll="eza --icons --group-directories-first -la"
alias la="eza --icons --group-directories-first -a"
alias lt="eza --icons --tree --level=2 --git-ignore"
alias lg="eza --icons --group-directories-first -la --git"

# bat — modern cat
alias cat="bat"
alias catp="bat --plain"          # no line numbers/borders, for copying

# ripgrep
alias rgi="rg -i"                 # case-insensitive
alias rgh="rg --hidden --no-ignore"   # include hidden + gitignored

# misc
alias lzg="lazygit"
alias y="yazi"
alias du="dust"
alias top="btop"
alias zshconfig="$EDITOR ~/.zshrc"
alias reload="exec zsh"

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------
eval "$(zoxide init zsh)"         # z <dir>, zi for interactive
eval "$(fzf --zsh)"               # Ctrl+R history, Ctrl+T files

# Make fzf use ripgrep so it respects .gitignore
export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git/*"'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# ---------------------------------------------------------------------------
# Prompt
# ---------------------------------------------------------------------------
eval "$(starship init zsh)"

# ---------------------------------------------------------------------------
# Plugins — syntax-highlighting MUST stay last in this file
# ---------------------------------------------------------------------------
_brew_share="${HOMEBREW_PREFIX:-/opt/homebrew}/share"
[[ -r $_brew_share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] \
  && source $_brew_share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -r $_brew_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] \
  && source $_brew_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
# tmux: tn = new window; tr = rename window; tls = fzf switcher / creator
_tmux_go() {
  if [[ -n "$TMUX" ]]; then tmux switch-client -t "$1"; else tmux attach -t "$1"; fi
}
_tmux_session() {
  local name="$1"
  if tmux has-session -t "=$name" 2>/dev/null; then
    _tmux_go "=$name"
  elif [[ -n "$TMUX" ]]; then
    tmux new-session -d -s "$name" && tmux switch-client -t "=$name"
  else
    tmux new-session -s "$name"
  fi
}
# tn [name] = new window in current dir; outside tmux, starts/attaches a session
tn() {
  if [[ -n "$TMUX" ]]; then
    tmux new-window -c "#{pane_current_path}" ${1:+-n "$1"}
  else
    _tmux_session "${1:-main}"
  fi
}
# tr <name> = rename the current window (shadows coreutils `tr` in interactive shells)
alias tr='tmux rename-window'
tls() {
  local out key sel
  if ! tmux list-sessions &>/dev/null; then
    local w=40 h=7 name i
    local cols=$(tput cols) rows=$(tput lines)
    local top=$(( (rows - h) / 2 + 1 )) left=$(( (cols - w) / 2 + 1 ))
    # Gruvbox (morhetz) shades: panel bg1, border bg3, text fg1/fg0, dim fg4
    local bg=$'\e[48;2;60;56;54m' bd=$'\e[38;2;102;92;84m' ac=$'\e[1;38;2;251;241;199m'
    local dm=$'\e[38;2;168;153;132m' tx=$'\e[38;2;235;219;178m' rs=$'\e[0m'
    local bar=${(l:$((w-2))::─:)""} fill=$(printf "%*s" $((w-2)) "")
    clear
    printf '\e[%d;%dH%s%s┌%s┐' $top $left $bg $bd $bar
    for i in {1..$((h-2))}; do
      printf '\e[%d;%dH%s%s│%s│' $((top+i)) $left $bg $bd $fill
    done
    printf '\e[%d;%dH%s%s└%s┘%s' $((top+h-1)) $left $bg $bd $bar $rs
    printf '\e[%d;%dH%s%stmux%s  ·  no active sessions%s' $((top+2)) $((left+3)) $bg $ac $dm $rs
    printf '\e[%d;%dH%s%sname %s› ' $((top+4)) $((left+3)) $bg $tx $ac
    printf '\e[%d;%dH%s%senter for "main"  ·  ctrl-c to cancel%s\e[%d;%dH%s' \
      $((top+5)) $((left+3)) $bg $dm $rs $((top+4)) $((left+10)) "$bg$tx"
    read -r name || { printf '%s' $rs; clear; return; }
    printf '%s' $rs; clear
    _tmux_session "${name:-main}"
    return
  fi
  out=$(tmux list-sessions -F '#{session_name}' 2>/dev/null |
    fzf --prompt='session › ' --print-query --color='fg:#a89984,fg+:#fbf1c7,bg+:#3c3836,hl:#ebdbb2,hl+:#fbf1c7,pointer:#ebdbb2,prompt:#ebdbb2,header:#a89984,info:#7c6f64,border:#665c54,gutter:-1' --expect=ctrl-n \
        --header='enter: switch | type new name + ctrl-n: create' \
        --preview='tmux list-windows -t {} 2>/dev/null') || [[ -n "$out" ]] || return
  key=$(sed -n 2p <<<"$out"); sel=$(sed -n 3p <<<"$out")
  if [[ "$key" == ctrl-n || -z "$sel" ]]; then
    sel=$(sed -n 1p <<<"$out")
    [[ -z "$sel" ]] && return
    _tmux_session "$sel"
  else
    _tmux_go "=$sel"
  fi
}
